{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "tsconfig.json"
  },
  "monorepo": true,
  "root": "apps/api",
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": { "tsConfigPath": "tsconfig.json" }
    },
    "chain": {
      "type": "library",
      "root": "libs/chain",
      "entryFile": "index",
      "sourceRoot": "libs/chain/src",
      "compilerOptions": { "tsConfigPath": "tsconfig.json" }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": { "tsConfigPath": "tsconfig.json" }
    },
    "events": {
      "type": "library",
      "root": "libs/events",
      "entryFile": "index",
      "sourceRoot": "libs/events/src",
      "compilerOptions": { "tsConfigPath": "tsconfig.json" }
    },
    "llm": {
      "type": "library",
      "root": "libs/llm",
      "entryFile": "index",
      "sourceRoot": "libs/llm/src",
      "compilerOptions": { "tsConfigPath": "tsconfig.json" }
    },
    "scoring": {
      "type": "library",
      "root": "libs/scoring",
      "entryFile": "index",
      "sourceRoot": "libs/scoring/src",
      "compilerOptions": { "tsConfigPath": "tsconfig.json" }
    },
    "templates": {
      "type": "library",
      "root": "libs/templates",
      "entryFile": "index",
      "sourceRoot": "libs/templates/src",
      "compilerOptions": { "tsConfigPath": "tsconfig.json" }
    },
    "x402": {
      "type": "library",
      "root": "libs/x402",
      "entryFile": "index",
      "sourceRoot": "libs/x402/src",
      "compilerOptions": { "tsConfigPath": "tsconfig.json" }
    },
    "shared-types": {
      "type": "library",
      "root": "libs/shared-types",
      "entryFile": "index",
      "sourceRoot": "libs/shared-types/src",
      "compilerOptions": { "tsConfigPath": "tsconfig.json" }
    }
  }
}
